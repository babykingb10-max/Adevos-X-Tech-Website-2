# ===== Server =====
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://www.adevosxtech.site

# ===== Database =====
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/adevosx

# ===== Auth =====
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ===== Transactional Email (OTP, feedback replies) =====
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Adevos-X Tech <no-reply@adevosxtech.site>
ADMIN_NOTIFY_EMAIL=admin@adevosxtech.site

# ===== Deployment Platform APIs =====
KOYEB_API_KEY=
RENDER_API_KEY=
RAILWAY_API_KEY=
FLYIO_API_TOKEN=

# ===== Payments =====
PAYSTACK_SECRET_KEY=
MANUAL_PAYMENT_INSTRUCTIONS="Pay via M-Pesa: 07XXXXXXXX (Adevos-X Tech)"

# ===== Admin bootstrap (first launch only) =====
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change_this_immediately
